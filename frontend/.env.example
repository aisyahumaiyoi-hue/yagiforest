# ---------------------------------------------------------------------------
# YAGI frontend configuration (example / template)
#
# Copy to frontend/.env and set the real backend URL. Never commit the real
# file. React only exposes REACT_APP_* variables to the browser, so nothing
# secret may ever be placed here.
# ---------------------------------------------------------------------------

# Backend origin, no trailing slash, no /api suffix.
# Local development: http://localhost:8001
# Production:        https://api.yagi.id
REACT_APP_BACKEND_URL=http://localhost:8001

ENABLE_HEALTH_CHECK=false
