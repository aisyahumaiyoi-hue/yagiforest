# ---------------------------------------------------------------------------
# YAGI backend configuration (example / template)
#
# Copy to backend/.env and fill in real values. NEVER commit the real .env:
# it is already covered by .gitignore. The project owner supplies secret values
# externally; do not invent or reuse the placeholders below in production.
# ---------------------------------------------------------------------------

# --- environment -----------------------------------------------------------
# development | staging | production
# In production the app refuses to start without a real JWT_SECRET, and CORS
# must list explicit origins instead of "*".
APP_ENV=development

# --- database --------------------------------------------------------------
MONGO_URL=mongodb://localhost:27017
# Use a distinct database per environment. Do NOT point production at a name
# like "test_database".
DB_NAME=yagi_dev

# --- security --------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Comma-separated list of exact allowed origins. Localhost is only needed in
# development. Example:
#   CORS_ORIGINS=https://app.yagi.id,https://yagi-preview.example.com
CORS_ORIGINS=http://localhost:3000

# --- Ask YAGI (Shiteru AI) -------------------------------------------------
SHITERU_API_KEY=
SHITERU_BASE_URL=https://shiteru.id/v1
SHITERU_MODEL=deepseek-v4-flash

# --- superadmin ------------------------------------------------------------
# Comma-separated email allowlist. Superadmin role is assigned server-side from
# this list at registration; it can never be set from any client request.
SUPERADMIN_EMAILS=

--- abuse / rate limits --------------------------------------------------
AI_ANON_REQUESTS_PER_HOUR=15
AI_USER_REQUESTS_PER_HOUR=60
AI_MAX_OUTPUT_TOKENS=700
AI_MAX_HISTORY_MESSAGES=8
AUTH_LOGIN_ATTEMPTS_PER_HOUR=20
AUTH_REGISTER_ATTEMPTS_PER_HOUR=10

# --- business rules --------------------------------------------------------
BUSINESS_TIMEZONE=Asia/Jakarta

# --- demo data -------------------------------------------------------------
# Keep at 0. When set to 1 the backend seeds fabricated demonstration orders and
# reviews on an empty database. Never enable this against production data.
SEED_DEMO_DATA=0
